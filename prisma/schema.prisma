// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())

  // Projects created by the user
  projects  Project[]

  // Projects the user is a member of
  projectMembers  ProjectMember[]

  // Tasks created by the user
  tasks     Task[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Foreign key to User or Project creator
  creatorId   Int
  user        User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // Project members
  members     ProjectMember[]

  // Tasks associated with this project
  tasks       Task[]
}

model Task {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Foreign key to Project
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Foreign key to User or Task creator
  creatorId   Int
  user        User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
  NEED_INFO
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model ProjectMember {
  id          Int      @id @default(autoincrement())

  userId      Int
  projectId   String

  // Foreign key to User who is a member of the Project
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Foreign key to Project that User have access to OR member of the same
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  role      ProjectRole @default(MEMBER)

  // Ensures a user can only be added once to the same project
  @@unique([userId, projectId])
}

enum ProjectRole {
  ADMIN
  EDITOR
  VIEWER
  MEMBER
}
